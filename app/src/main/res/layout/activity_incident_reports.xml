<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/sisonke_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:background="@color/sisonke_navy" android:padding="18dp">
        <TextView android:id="@+id/btnReportsBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="‹" android:textSize="30sp"
            android:textColor="@color/sisonke_white" android:paddingEnd="18dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/incident_reports" android:textColor="@color/sisonke_white"
            android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/tvReportsStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp"
        android:text="@string/loading_incident_reports" android:textColor="@color/sisonke_grey" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/incidentList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" />
    </ScrollView>
</LinearLayout>

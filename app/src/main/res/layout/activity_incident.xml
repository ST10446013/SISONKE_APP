<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sisonke_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report Incident"
            android:textColor="@color/sisonke_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Incident Category"
                android:textColor="@color/sisonke_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="What Happened"
                android:textColor="@color/sisonke_black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="Describe what happened"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColorHint="@color/sisonke_grey"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_outline"
                android:drawableStart="@drawable/ic_location_grey"
                android:drawablePadding="8dp"
                android:text="Use Current Location"
                android:textAllCaps="false"
                android:textColor="@color/sisonke_black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Location not selected"
                android:textColor="@color/sisonke_grey"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPhoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_outline"
                android:drawableStart="@drawable/ic_camera_grey"
                android:drawablePadding="8dp"
                android:text="Add Photo"
                android:textAllCaps="false"
                android:textColor="@color/sisonke_black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSubmitIncident"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:text="Submit Incident"
                android:textAllCaps="false"
                android:textColor="@color/sisonke_white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>